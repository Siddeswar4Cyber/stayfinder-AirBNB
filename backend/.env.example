# Local path from backend/. In production, use the absolute path on persistent
# storage (for Railway, attach a volume mounted at /data).
DATABASE_PATH=stayfinder.db

# Required in production; generate at least 32 random characters.
APP_SECRET=

# Explicit browser origins for production, comma-separated.
CORS_ORIGINS=http://localhost:3000

# Set explicitly; the application defaults to production-safe startup.
APP_ENV=development

# Production only: set both once to create the first administrator account.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Keep true only for local synthetic demo data.
ALLOW_DEMO_SEED=true
